# LOKÁL (.env) — teszt kulcsok. Éles kulcsok → Vercel Environment Variables.

DATABASE_URL=
ADMIN_PASSWORD=takemo-admin
SUPERUSER_EMAIL=avers.freelance@gmail.com
NOTIFY_EMAIL=avers.freelance@gmail.com
PUBLIC_URL=http://localhost:5173

# Stripe Test mode: sk_test_... (Developers → API keys → Secret key)
STRIPE_SECRET_KEY=

# Lokál webhook: stripe listen → whsec_... (NEM az éles Dashboard webhook)
STRIPE_WEBHOOK_SECRET=

# Éles (Vercel Production only, ne ide):
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...  (Live Dashboard webhook)
# PUBLIC_URL=https://takemo.co.uk

GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
